# Copy this file to credential/.env and fill in your own values.
# Keys can also be set later from the app's Settings page (UI values override this file).

# --- Apify (Facebook Pages + TikTok data) ---
# Get it at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- LLM ---
# LLM_PROTOCOL: "anthropic" (Claude, or Z.ai via its Anthropic-compatible endpoint)
#               "openai"    (OpenAI, OpenRouter, Gemini, Ollama, any OpenAI-compatible API)
LLM_PROTOCOL=openai
# Leave empty for the provider default. Examples:
#   Anthropic: (empty, with LLM_PROTOCOL=anthropic and a model such as claude-sonnet-5-5)
#   Z.ai:      https://api.z.ai/api/anthropic
#   OpenAI:    (empty)
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
